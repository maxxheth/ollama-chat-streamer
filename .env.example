# Ollama configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=lfm2.5
OLLAMA_MODEL_FALLBACKS=

# Chat configuration
CHAT_LOG_DEST=chat_log.txt
CONTEXT_PATH=
CONTEXT_GREP=txt,log
EXPERIMENTAL=false
EXPERIMENTAL_WEBSEARCH=false
PERSIST_TO_DB=false
TOOL_OUTPUT_DIR=sessions

# Timeout configuration (seconds)
OLLAMA_TIMEOUT=120
TOOL_TIMEOUT=30
WEB_SEARCH_TIMEOUT=30
OLLAMA_FIRST_TOKEN_TIMEOUT=20
OLLAMA_STREAM_IDLE_TIMEOUT=15

# Retry configuration
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=0.5
RETRY_MAX_DELAY=8.0
RETRY_MULTIPLIER=2.0
RETRY_JITTER=0.1

# UI configuration
SPINNER_ENABLED=true
SPINNER_STYLE=line
SPINNER_INTERVAL=0.1
SPINNER_STALL_DELAY=1.5
RENDER_DELAY=0.0

# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatdb
